  "npcs": {
    "ginmaku": {
      "name": "VOCAL 銀幕一楼",
      "topics": [
        {
          "once": true,
          "lines": ["ようこそ、楽屋へ。", "ここは俺たち銀幕一楼とTIMECAFEの秘密基地みたいなもんだ。", "……そうだ、次のライブ、観に来てくれるか？"],
          "choices": [
            { "label": "もちろん！", "lines": ["よし、最高のステージ見せてやるよ。", "約束だからな。"], "set": "promised_live" },
            { "label": "考えとく", "lines": ["つれないな。……ま、気が向いたら来いよ。"] }
          ]
        },
        { "if": "promised_live", "lines": ["約束、忘れんなよ。待ってるからな。"] },
        { "lines": ["最近の俺たちの動き、チェックしてるか？", "{{news}}", "見逃すなよ。"] },
        { "lines": ["この赤いスーツ、似合ってるだろ？"] }
      ]
    },
    "kenta": {
      "name": "BASS 松永健太",
      "topics": [
        { "lines": ["よう！ベースの松永健太だ。", "このアンプ、年季入ってるけどいい音出すんだぜ。"] },
        { "lines": ["低音は体で感じるもんだ。ライブで確かめてくれよな。"] },
        { "lines": ["パンも焼くしベースも弾く。どっちも仕込みが大事なんだ。"] },
        { "lines": ["そういえば君、うちのサイトの{{visitors}}人目のお客さんらしいぜ。", "楽屋まで遊びに来たのは君くらいだけどな。"] }
      ]
    },
    "takashi": {
      "name": "GUITAR 塚原嵩",
      "topics": [
        {
          "once": true,
          "lines": ["……ちょっと待って、今いいとこ。", "この近くの美味い店、スマホで検索してるんだ。", "ライブ終わりの打ち上げ、どっちがいいと思う？"],
          "choices": [
            { "label": "担々麺の店", "lines": ["お、わかってるね。深夜までやってる店を見つけたんだ。", "決まりだな。"], "set": "dinner_tantan" },
            { "label": "焼肉の店", "lines": ["だよな！星4.2の店があるんだよ。", "予約しとくわ。"], "set": "dinner_yakiniku" }
          ]
        },
        { "if": "weather_rain", "lines": ["外、{{weather}}だってさ。", "機材の搬入が大変なんだよな……。"] },
        { "if": "dinner_tantan", "lines": ["担々麺、楽しみだな〜。", "……ギター？ ああ、弾くよ。飯の後でな。"] },
        { "if": "dinner_yakiniku", "lines": ["焼肉、楽しみだな〜。", "……ギター？ ああ、弾くよ。飯の後でな。"] },
        { "lines": ["スマホの充電が切れそうだ……。"] }
      ]
    },
    "ayako": {
      "name": "DRUMS 瀬間絢子",
      "topics": [
        {
          "if": "live_today",
          "lines": ["って、ライブ今日じゃん！", "なんでみんな楽屋でのんびりしてるの！？", "……あなたも観に来てくれるよね？"]
        },
        {
          "lines": ["あ、来てくれたんだ！ありがとう。", "次のライブのスケジュール、教えてあげるね。", "{{next_live}}", "絶対来てね！待ってるから。"],
          "set": "heard_schedule"
        },
        {
          "lines": ["冷蔵庫に差し入れのプリンがあるんだけど……", "誰にも言わないでね？"],
          "set": "knows_pudding"
        },
        { "lines": ["ドラムは体力勝負だからね。ライブ前はストレッチ！"] },
        { "if": "!live_today", "lines": ["次のライブまで{{live_countdown}}！", "……考えてたらそわそわしてきた。"] }
      ]
    },
    "saeko": {
      "name": "KEYBOARD 野口紗依子",
      "topics": [
        {
          "if": "time_night",
          "once": true,
          "lines": ["……あら、こんな時間まで起きてるの？", "ふふ、夜ふかし仲間ね。", "私たちも曲作りはだいたい深夜なの。"]
        },
        {
          "if": "time_morning",
          "once": true,
          "lines": ["おはよう。朝から来てくれるなんて熱心ね。", "私はまだ目が覚めてないけど……。"]
        },
        { "lines": ["いらっしゃい。鏡の前、ちょっとごめんね。", "メイク直してたところなの。"] },
        { "lines": ["ポスター、新しいデザインどっちがいいと思う？", "……ふふ、参考にするね。"] },
        { "lines": ["鍵盤はね、バンドの景色を塗る仕事なの。"] }
      ]
    }
  },
  "objects": {
    "fridge": {
      "name": "冷蔵庫",
      "topics": [
        {
          "if": "knows_pudding",
          "once": true,
          "lines": ["冷蔵庫を開けた。", "プリン発見！……絢子さんの差し入れだ。", "そっと閉めた。"],
