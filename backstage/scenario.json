  "npcs": {
    "ginmaku": {
      "name": "VOCAL 銀幕一楼",
      "topics": [
        {
          "once": true,
          "lines": [
            "ようこそ、銀幕一座の楽屋へ。",
            "まぁ楽屋と言ってもホームページの中の一部なんだけどね。",
            "……そうだ、次のライブ、観に来てくれるかな？"
          ],
          "choices": [
            {
              "label": "もちろん！",
              "lines": [
                "よし、最高のステージ見せてやるよ。",
                "トラウマ級のな。"
              ],
              "set": "promised_live"
            },
            {
              "label": "考えとく",
              "lines": [
                "つれないな。……ま、気が向いたらお願いね。"
              ]
            }
          ]
        },
        {
          "if": "promised_live",
          "lines": [
            "ちゃんせまに話しかけると、次のライブの情報を聞けるよ。"
          ],
          "once": true
        },
        {
          "lines": [
            "最近の我々のNEWS、チェックしてる？",
            "{{news}}",
            "よろしくな。素敵な夜を☆彡"
          ]
        },
        {
          "lines": [
            "このスーツ、いいでしょ。"
          ]
        }
      ]
    },
    "kenta": {
      "name": "BASS 松永健太",
      "topics": [
        {
          "lines": [
            "みんな横から話しかけてもずっと下を向いてるだろ？",
            "まだ横向きの画像を作ってないんだ。",
            "キャラクターのドットは手作業で描いてるんだよね。"
          ]
        },
        {
          "lines": [
            "これはここだけの話なんだけど…",
            "雨の日にタカシに話しかけるとレアな会話が出来るよ。"
          ]
        },
        {
          "lines": [
            "次はどんな機能をHPに導入しようかな〜"
          ]
        },
        {
          "lines": [
            "楽屋のドアを調べると、トップページに戻る事が出来るよ。"
          ]
        }
      ]
    },
    "takashi": {
      "name": "GUITAR 塚原嵩",
      "topics": [
        {
          "once": true,
          "lines": [
            "……ちょっと待ってて。",
            "今この近くの美味い店、スマホで検索してるんだ。",
            "ライブ終わりの打ち上げ、どっちがいいと思う？"
          ],
          "choices": [
            {
              "label": "担々麺の店",
              "lines": [
                "お、わかってるね。深夜までやってる店を見つけたんだ。",
                "決まりだな。"
              ],
              "set": "dinner_tantan"
            },
            {
              "label": "焼肉の店",
              "lines": [
                "だよな！星4.2の店があるんだよ。",
                "予約しとくわ。"
              ],
              "set": "dinner_yakiniku"
            }
          ]
        },
        {
          "if": "weather_rain",
          "lines": [
            "今日、{{weather}}だってさ。",
            "またみんなに雨男って言われちゃうよ…"
          ]
        },
        {
          "if": "dinner_tantan",
          "lines": [
            "担々麺、楽しみだな〜。"
          ]
        },
        {
          "if": "dinner_yakiniku",
          "lines": [
            "焼肉、楽しみだな〜。"
          ]
        },
        {
          "lines": [
            "そこにあるアンプ、僕のなんだよね。"
          ]
        }
      ]
    },
    "ayako": {
      "name": "DRUMS 瀬間絢子",
      "topics": [
        {
          "if": "live_today",
          "lines": [
            "あっ！",
            "今日はライブ当日だね！",
            "……あなたも観に来てくれるかな？"
          ]
        },
        {
          "lines": [
            "あ、来てくれたんだ！ありがとう。",
            "次のライブのスケジュール、教えてあげるね。",
            "{{next_live}}",
            "絶対来てね！待ってるから。"
          ],
          "set": "heard_schedule"
        },
        {
          "lines": [
            "冷蔵庫に差し入れのプリンがあるんだよね……",
            "いつ食べようかな？"
          ],
          "set": "knows_pudding"
        },
        {
          "lines": [
            "ドラムは体力勝負だからね。ライブ前はストレッチ！"
          ]
        },
        {
          "if": "!live_today",
          "lines": [
            "次のライブまで{{live_countdown}}！",
            "練習しなきゃな〜"
          ]
        }
      ]
    },
    "saeko": {
      "name": "KEYBOARD 野口紗依子",
      "topics": [
        {
          "if": "time_night",
          "once": true,
          "lines": [
            "……あら、こんな時間まで起きてるの？",
            "ふふ、夜ふかし仲間ね。"
          ]
        },
        {
          "if": "time_morning",
          "once": true,
          "lines": [
            "おはよう。朝から来てくれるなんて熱心ね。",
            "私はまだ目が覚めてないけど……。"
          ]
        },
        {
          "lines": [
            "いらっしゃい。鏡の前、ちょっとごめんね。",
            "メイク直してたところなの。"
          ]
        },
        {
          "lines": [
            "あ、セットリストの色紙書かなきゃ…",
            "ライブでセットリスト色紙は買ったことある？"
          ],
          "choices": [
            {
              "label": "ある",
              "lines": [
                "ありがとう！また買ってね。"
              ]
            },
            {
              "label": "ない",
              "lines": [
                "ホームページのトップから予約フォームに飛べるから",
                "良かったらチェックしてみてね。"
              ]
            }
          ]
        },
        {
          "lines": [
            "あなたは、うちのサイトの{{visitors}}人目のご贔屓様みたいね。",
            "楽屋まで遊びに来てくれてありがとうね。"
          ]
        }
      ]
    }
  },
