        { "lines": ["黒とシルバーの渋いポスター。", "紗依子さんの趣味らしい。"] }
      ]
    },
    "setlist": {
      "name": "セットリスト",
      "topics": [
        { "if": "promised_live", "lines": ["次のライブのセットリストだ。", "……見たいけど、当日のお楽しみにしておこう。"] },
        { "lines": ["何かの紙が貼ってある。", "曲名らしきものが並んでいるが、よく読めない。"] }
      ]
